# DocuVault Frontend Environment Variables
# Copy to .env and fill in your values

# --- MODE ---
# Set to true for local demo mode (no AWS required)
# Set to false to use real AWS backend
VITE_DEMO_MODE=true

# --- AWS Backend (required when VITE_DEMO_MODE=false) ---
# Your API Gateway URL (e.g. https://b4reqq8h9a.execute-api.ap-southeast-2.amazonaws.com)
VITE_API_URL=https://b4reqq8h9a.execute-api.ap-southeast-2.amazonaws.com

# --- AWS Cognito (required when VITE_DEMO_MODE=false and Cognito is enabled) ---
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-southeast-2

# --- Optional ---
# App name shown in title
VITE_APP_NAME=DocuVault
